function scrGetProperName(item){
    
    if (item == "HP Upgrade") {
        
        return sHPUpgrade;
        
    }
    else if (item == "Air Upgrade") {
        
        return sAirUpgrade;
        
    }
    else if (item == "Attack Upgrade") {
        
        return sAttackUpgrade;
        
    }
    else if (item == "Board Upgrade") {
        
        return sBoardUpgrade;
        
    }
    else if (item == "Heal"){
        
        return sHeal;
        
    }
    return "";
    
}